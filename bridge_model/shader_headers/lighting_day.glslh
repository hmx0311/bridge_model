#include "scene_constances.h"
#include "camera_defines.h"
#include "lighting_day_defines.h"

#define NUM_BLOCKER_SAMPLE 16

layout(binding = 1) uniform sampler2DArrayShadow shadowTex;
layout(binding = 2) uniform sampler2DArray shadow_tex_depth;

float shadowPCSS(vec3 world_position, vec3 dpdx, vec3 dpdy, vec3 surface_normal, float sample_cnt_factor)
{
	int level;
	vec3 shadow_coord;
	vec3 u_dir, v_dir;
	float shadow_scale_u, shadow_scale_v;
	float tex_padding_u, tex_padding_v;
	for (level = 0; level < CSM_LEVELS; level++)
	{
		u_dir = vec3(sun_shadow.tex[level][0].x, sun_shadow.tex[level][1].x, sun_shadow.tex[level][2].x);
		v_dir = vec3(sun_shadow.tex[level][0].y, sun_shadow.tex[level][1].y, sun_shadow.tex[level][2].y);
		shadow_scale_u = length(u_dir);
		shadow_scale_v = length(v_dir);
		tex_padding_u = max(MIN_SHADOW_MAP_PADDING, MAX_PENUMBRA_RADIUS * shadow_scale_u);
		tex_padding_v = max(MIN_SHADOW_MAP_PADDING, MAX_PENUMBRA_RADIUS * shadow_scale_v);
		shadow_coord = (sun_shadow.tex[level] * vec4(world_position, 1.0)).xyz;
		if (shadow_coord.x > tex_padding_u && shadow_coord.x < 1 - tex_padding_u &&	shadow_coord.y > tex_padding_v && shadow_coord.y < 1 - tex_padding_v && shadow_coord.z < 1)
		{
			break;
		}
	}
	if (level >= CSM_LEVELS)
	{
		return 1.0;
	}
	u_dir /= shadow_scale_u;
	v_dir /= shadow_scale_v;
	vec2 duvdx = 0.5 * vec2(dot(u_dir, dpdx), dot(v_dir, dpdx));
	vec2 duvdy = 0.5 * vec2(dot(u_dir, dpdy), dot(v_dir, dpdy));
	float duvdx_len = length(duvdx);
	float duvdy_len = length(duvdy);
	int mip_level = min(findMSB(int(ceil(2 * SHADOW_DAY_TEX_SIZE * MAX_PENUMBRA_RADIUS * max(shadow_scale_u, shadow_scale_v)) - 1)), PCSS_MIP_LEVELS);
	float nearest_depth = 1.0;
	ivec2 mip_idx = ivec2(floor((SHADOW_DAY_TEX_SIZE >> mip_level) * shadow_coord.xy - 0.5));
	nearest_depth = min(nearest_depth, texelFetch(shadow_tex_depth, ivec3(clamp(mip_idx, 0, (SHADOW_DAY_TEX_SIZE >> mip_level) - 1), level), mip_level).x);
	nearest_depth = min(nearest_depth, texelFetch(shadow_tex_depth, ivec3(clamp(mip_idx + ivec2(0, 1), 0, (SHADOW_DAY_TEX_SIZE >> mip_level) - 1), level), mip_level).x);
	nearest_depth = min(nearest_depth, texelFetch(shadow_tex_depth, ivec3(clamp(mip_idx + ivec2(1, 0), 0, (SHADOW_DAY_TEX_SIZE >> mip_level) - 1), level), mip_level).x);
	nearest_depth = min(nearest_depth, texelFetch(shadow_tex_depth, ivec3(clamp(mip_idx + ivec2(1, 1), 0, (SHADOW_DAY_TEX_SIZE >> mip_level) - 1), level), mip_level).x);
	if(nearest_depth >= shadow_coord.z)
	{
		return 1.0;
	}
	float penumbra_ratio = SUN_RADIUS_DIST_RATIO * sun.light_dir_and_radius.w;
	vec3 shadow_mat_z = vec3(sun_shadow.tex[level][0].z, sun_shadow.tex[level][1].z, sun_shadow.tex[level][2].z);
	float shadow_inv_scale_z = 1.0 / length(shadow_mat_z);
	vec2 dzduv;
	{
		vec3 temp = cross(v_dir, surface_normal);
		dzduv.s = dot(temp, shadow_mat_z) / (dot(u_dir, temp) * shadow_scale_u);
		temp = cross(u_dir, surface_normal);
		dzduv.t = dot(temp, shadow_mat_z) / (dot(v_dir, temp) * shadow_scale_v);
	}
	int blocker_cnt = 0;
	float block_dist = 0;
	float total_weight = 0.0;
	float blocker_search_r = min((shadow_coord.z - nearest_depth) * shadow_inv_scale_z * penumbra_ratio, MAX_PENUMBRA_RADIUS);
	float min_unblock_r = blocker_search_r;
	uint pixel_seed = uint(gl_FragCoord.x * 193.0 + gl_FragCoord.y * 97.0);
	for (int i = 0; i < NUM_BLOCKER_SAMPLE; i++)
	{
		float r = blocker_search_r * (i + 0.5) / NUM_BLOCKER_SAMPLE;
		float angle = 2 * 3.1415927 * (2.3283064e-10 * bitfieldReverse(uint(i) ^ pixel_seed) + float(camera.taa_phase) / TAA_PERIOD);
		vec2 coord_offset = r * vec2(cos(angle) * shadow_scale_u, sin(angle) * shadow_scale_v);
		float offset_z = min(0.0, dot(coord_offset, dzduv) - 0.01 * r);
		float dist = shadow_coord.z - texture(shadow_tex_depth, vec3(shadow_coord.xy + coord_offset, level)).x;
		if (dist > -offset_z)
		{
			dist *= shadow_inv_scale_z;
			float k = blocker_search_r / (dist * penumbra_ratio) - 1;
			float weight = (2 + k) / (1 + k * r / blocker_search_r);
			total_weight += weight;
			block_dist += weight * dist;
			blocker_cnt++;
		}
		else
		{
			min_unblock_r = min(r, min_unblock_r);
		}
	}
	if(total_weight == 0.0)
	{
		return 1.0;
	}
	block_dist /= total_weight;
	float penumbra_radius = min(penumbra_ratio * block_dist, MAX_PENUMBRA_RADIUS);
	if (min_unblock_r >= min(blocker_search_r, penumbra_radius + 4.0 / NUM_BLOCKER_SAMPLE * blocker_search_r))
	{
		return 0.0;
	}
	float shadow = 0.0;
	pixel_seed = (pixel_seed ^ 0x9e3779b9u) * 0x85ebca6bu;
	int sample_cnt = max(1, int(4 * sample_cnt_factor * sqrt(penumbra_radius / min(duvdx_len, duvdy_len))));
	for (int idx = 0; idx < sample_cnt; idx++)
	{
		float r = sqrt((idx + float(camera.taa_phase) / TAA_PERIOD) / sample_cnt);
		float angle = 2 * 3.1415927 * (2.3283064e-10 * bitfieldReverse(uint(idx) ^ pixel_seed) + float(camera.taa_phase) / TAA_PERIOD);
		vec2 coord_offset = r * penumbra_radius * vec2(cos(angle) * shadow_scale_u, sin(angle) * shadow_scale_v);
		vec2 coord = shadow_coord.xy + coord_offset;
		float offset_z = min(0.0, dot(coord_offset, dzduv) - 0.01 * penumbra_radius * r);
		shadow += texture(shadowTex, vec4(coord.xy, level, shadow_coord.z + offset_z)).x;
	}
	shadow /= sample_cnt;
	return shadow;
}
