#include "camera_defines.h"

#define FOG_DENSITY 0.001f
#define FOG_TOP 400.0f

float fogFactor(vec3 position)
{
	float fog_factor;
	vec3 camera_pos = camera.inv_view[3].xyz;
	if(position.z > FOG_TOP && camera_pos.z > FOG_TOP)
	{
		return 1.0;
	}
	float distance = length(position - camera_pos);
	if(position.z > FOG_TOP || camera_pos.z > FOG_TOP)
	{
		distance *= (FOG_TOP - min(position.z, camera_pos.z)) / abs(position.z - camera_pos.z);
	}
	{
		float temp = FOG_DENSITY * distance;
		fog_factor = exp(-temp * temp);
	}
	return fog_factor;
}
