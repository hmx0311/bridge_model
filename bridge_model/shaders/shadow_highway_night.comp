#include "lighting_night_defines.h"

layout(std430, binding = VERTEX_BUFFER_BINDING) buffer vertex_block
{ 
    float vertices[];
};

layout(std430, binding = INDEX_BUFFER_BINDING) buffer index_block
{ 
    uint indices[];
};

layout (local_size_x = 64) in;

uniform int num_triangles;

void main()
{
    uint triangle_idx = gl_GlobalInvocationID.x;
	if(triangle_idx >= num_triangles)
	{
		return;
	}
	vec3 positions[3];
	uint vert_idx[3];
	for(uint i = 0; i < 3; i++)
	{
		vert_idx[i] = indices[3 * triangle_idx + i];
		uint offset = 3 * vert_idx[i];
		positions[i] = vec3(vertices[offset], vertices[offset + 1], vertices[offset + 2]);
	}
	vec2 min_coord = positions[0].xy;
	vec2 max_coord = min_coord;
	min_coord = min(min_coord, positions[1].xy);
	min_coord = min(min_coord, positions[2].xy);
	max_coord = max(max_coord, positions[1].xy);
	max_coord = max(max_coord, positions[2].xy);
	ivec2 start_idx = ivec2(min_coord / LIGHT_MAP_GRID_LENGTH + vec2(0.5 * LIGHT_MAP_SIZE_X, 0.5 * LIGHT_MAP_SIZE_Y) -1);
	ivec2 end_idx = ivec2(max_coord / LIGHT_MAP_GRID_LENGTH + vec2(0.5 * LIGHT_MAP_SIZE_X, 0.5 * LIGHT_MAP_SIZE_Y) + 1);

	int i = start_idx.x;
	int j = start_idx.y;
	int gird_idx = i * LIGHT_MAP_SIZE_Y + j;
	int k = tile_light_map.idx_range[gird_idx].x;
	int end = min(tileLightShadowLayerOffset(NUM_TILE_LIGHT_SHADOW_LAYERS), tile_light_map.idx_range[gird_idx].y);
	for(;;k++)
	{
		while(k >= end)
		{
			j++;
			if(j > end_idx.y)
			{
				i++;
				if(i > end_idx.x)
				{
					return;
				}
				j = start_idx.y;
			}
			gird_idx = i * LIGHT_MAP_SIZE_Y + j;
			k = tile_light_map.idx_range[gird_idx].x;
			end = min(tileLightShadowLayerOffset(NUM_TILE_LIGHT_SHADOW_LAYERS), tile_light_map.idx_range[gird_idx].y);
		}
		vec3 normal = cross(positions[1] - positions[0], positions[2] - positions[0]);
		if(dot(normal, tile_lights[k].position.xyz - positions[0]) <= 0)
		{
			continue;
		}
		vec4 pos[3];
		for(int p = 0; p < 3; p++)
		{
			pos[p] = tile_lights[k].view_proj * vec4(positions[p], 1.0);
		}
		if(pos[0].x >= pos[0].w && pos[1].x >= pos[1].w && pos[2].x >= pos[2].w ||
			pos[0].x <= -pos[0].w && pos[1].x <= -pos[1].w && pos[2].x <= -pos[2].w ||
			pos[0].y >= pos[0].w && pos[1].y >= pos[1].w && pos[2].y >= pos[2].w ||
			pos[0].y <= -pos[0].w && pos[1].y <= -pos[1].w && pos[2].y <= -pos[2].w ||
			pos[0].z >= pos[0].w && pos[1].z >= pos[1].w && pos[2].z >= pos[2].w ||
			pos[0].z <= -pos[0].w && pos[1].z <= -pos[1].w && pos[2].z <= -pos[2].w)
		{
			continue;
		}
		bool intersected = pos[0].x * pos[1].y - pos[0].y * pos[1].x > 0
						&& pos[1].x * pos[2].y - pos[1].y * pos[2].x > 0
						&& pos[2].x * pos[0].y - pos[2].y * pos[0].x > 0
						|| pos[0].w > 0 && dot(pos[0].xy, pos[0].xy) < pos[0].w * pos[0].w
						|| pos[1].w > 0 && dot(pos[1].xy, pos[1].xy) < pos[1].w * pos[1].w
						|| pos[2].w > 0 && dot(pos[2].xy, pos[2].xy) < pos[2].w * pos[2].w;
		if(!intersected)
		{
			vec2 test[3];
			for(int p = 0; p < 3; p++)
			{
				test[p] = pos[p].xy / (pos[p].w == 0.0 ? -1e-6 : pos[p].w);
			}
			for(int p = 0; p < 3 && !intersected; p++)
			{
				int q = (p + 1) % 3;
				vec2 a = test[p];
				vec2 v = test[q] - a;
				float lower_v2 =  v.x * a.y - v.y * a.x;
				lower_v2 = lower_v2 * lower_v2;
				if(pos[q].w < 0)
				{
					if(pos[p].w < 0)
					{
						continue;
					}
					v = -v;
				}
				else if(pos[p].w < 0)
				{
					a = test[q];
				}
				else
				{	
					lower_v2 = max(dot(a, a) - 1, lower_v2);
				}
				intersected = dot(v, a) < 0 && dot(v, v) > lower_v2;
			}
		}
		if(intersected)
		{
			int layer = findTileLightShadowLayer(k);
			int layer_triangle_idx = atomicAdd(tile_light_shadow_triangles.commands[layer].count, 3) / 3;
			layer_triangle_idx += MAX_AVERANGE_TRIANGLES_PER_LIGHT * tileLightShadowLayerOffset(layer);
			tile_light_shadow_triangles.triangles[layer_triangle_idx] = TileLightShadowTriangle(vert_idx, k);
		}
	}
}
